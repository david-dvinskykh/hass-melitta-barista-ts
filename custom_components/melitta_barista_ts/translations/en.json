{
  "config": {
    "flow_title": "{name} ({address})",
    "step": {
      "confirm": {
        "title": "Add coffee machine",
        "description": "Set up {name} at {address}?\n\nThe machine has to be switched on and Bluetooth enabled in its menu. The first connection may take a moment while the two devices bond."
      },
      "user": {
        "title": "Add coffee machine",
        "data": {
          "address": "Machine"
        }
      }
    },
    "abort": {
      "already_configured": "This machine is already set up",
      "no_devices_found": "No Melitta Barista Smart machine found. Switch the machine on, enable Bluetooth in its menu, and make sure it is in range of a Bluetooth adapter or proxy.",
      "not_supported": "This Bluetooth device is not a Melitta Barista Smart machine"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Connection settings",
        "data": {
          "poll_interval": "Status poll interval",
          "frame_timeout": "Command timeout",
          "connect_timeout": "Connection timeout",
          "pairing_agent": "Register a Bluetooth pairing agent"
        },
        "data_description": {
          "poll_interval": "How often the machine status is refreshed.",
          "frame_timeout": "How long to wait for the machine to answer a command.",
          "connect_timeout": "How long to wait for the Bluetooth connection to come up.",
          "pairing_agent": "The machine bonds with numeric comparison, which the default BlueZ agent cannot confirm. Leave this on unless you bond through an ESPHome Bluetooth proxy or pair manually."
        }
      }
    }
  },
