  "services": {
    "brew": {
      "name": "Brew",
      "description": "Brews a drink. Anything left unset falls back to the value staged on the machine's entities.",
      "fields": {
        "drink": {
          "name": "Drink",
          "description": "Which drink to make. Defaults to the drink selected on the machine's Drink entity."
        },
        "two_cups": {
          "name": "Two cups",
          "description": "Dispense two cups in one run."
        },
        "intensity": {
          "name": "Strength",
          "description": "Coffee strength to use instead of the stored recipe value."
        },
        "temperature": {
          "name": "Brew temperature",
          "description": "Brew temperature to use instead of the stored recipe value."
        },
        "portion_ml": {
          "name": "Cup size",
          "description": "Cup size in millilitres, rounded to the nearest 5 ml."
        },
        "bean_hopper": {
          "name": "Bean hopper",
          "description": "Which bean hopper to grind from. Only dual-hopper machines act on this."
        },
        "profile": {
          "name": "Profile",
          "description": "Brew from a user profile instead of the built-in recipe. 0 is My Coffee, 1-8 are the named profiles. A profile only stores the seven direct-select drinks."
        }
      }
    },
    "cancel": {
      "name": "Cancel",
      "description": "Stops whatever the machine is currently doing."
    },
    "set_clock": {
      "name": "Set clock",
      "description": "Sets the clock shown on the machine.",
      "fields": {
        "time": {
          "name": "Time",
          "description": "Time to set. Defaults to the current local time."
        }
      }
    },
    "write_setting": {
      "name": "Write setting register",
      "description": "Writes a raw numerical register on the machine. Intended for exploring undocumented settings — a wrong value can put the machine into an unexpected state.",
      "fields": {
        "setting_id": {
          "name": "Register",
          "description": "Register ID, for example 11 for water hardness or 13 for the auto-off delay."
        },
        "value": {
          "name": "Value",
          "description": "Value to write."
        }
      }
    },
    "read_setting": {
      "name": "Read setting register",
      "description": "Reads a raw numerical register from the machine and returns its value.",
      "fields": {
        "setting_id": {
          "name": "Register",
          "description": "Register ID to read."
        }
      }
    },
    "scan_settings": {
      "name": "Scan registers",
      "description": "Read a range of numerical registers and return the ones the machine answers. Meant for discovering registers that are not documented yet; each register costs one round trip, so keep the range short.",
      "fields": {
        "first_id": {
          "name": "First register",
          "description": "Lowest register ID to read."
        },
        "last_id": {
          "name": "Last register",
          "description": "Highest register ID to read, inclusive."
        }
      }
    }
  },
  "exceptions": {
    "not_connected": {
      "message": "The coffee machine is not reachable over Bluetooth."
    }
  }
