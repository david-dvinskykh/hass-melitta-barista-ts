{
  "config": {
    "flow_title": "{name}",
    "step": {
      "confirm": {
        "title": "Add coffee machine",
        "description": "Set up {name} ({address})?\n\nThe machine must be switched on. If Home Assistant has never paired with it before, confirm the pairing request on the machine display."
      },
      "user": {
        "title": "Add coffee machine",
        "data": {
          "address": "Coffee machine"
        },
        "data_description": {
          "address": "Machines currently within range of a Bluetooth adapter or proxy."
        }
      }
    },
    "error": {
      "cannot_connect": "Could not connect. Make sure the machine is switched on, in range, and not connected to the Melitta Connect app.",
      "invalid_auth": "The machine refused the connection. Switch it off and on again, then retry."
    },
    "abort": {
      "already_configured": "This coffee machine is already set up.",
      "already_in_progress": "Setup for this coffee machine is already in progress.",
      "cannot_connect": "Could not connect. Make sure the machine is switched on, in range, and not connected to the Melitta Connect app.",
