  "services": {
    "brew": {
      "name": "Brew",
      "description": "Prepares one of the machine's built-in drinks.",
      "fields": {
        "device_id": {
          "name": "Coffee machine",
          "description": "The machine that should prepare the drink."
        },
        "recipe": {
          "name": "Drink",
          "description": "The drink to prepare. Red eye, black eye and dead eye are Barista TS only."
        },
        "two_cups": {
          "name": "Two cups",
          "description": "Prepare the drink twice in a row."
        }
      }
    },
    "brew_custom": {
      "name": "Brew custom drink",
      "description": "Prepares a drink from the parameters given here instead of a stored recipe.",
      "fields": {
        "device_id": {
          "name": "Coffee machine",
          "description": "The machine that should prepare the drink."
        },
        "process": {
          "name": "Dispense",
          "description": "What the machine should dispense."
        },
        "portion": {
          "name": "Portion",
          "description": "Amount to dispense, in millilitres. Rounded to the nearest 5 ml."
        },
        "milk_portion": {
          "name": "Milk portion",
          "description": "Amount of milk to add, in millilitres. Use 0 for a drink without milk."
        },
        "intensity": {
          "name": "Strength",
          "description": "Coffee strength."
        },
        "temperature": {
          "name": "Temperature",
          "description": "Brew temperature."
        },
        "hopper": {
          "name": "Bean hopper",
          "description": "Which hopper to grind from. The Barista T has one hopper and ignores this."
        },
        "name": {
          "name": "Name",
          "description": "Name shown on the machine display while preparing."
        },
        "two_cups": {
          "name": "Two cups",
          "description": "Prepare the drink twice in a row."
        }
      }
    },
    "cancel": {
      "name": "Cancel",
      "description": "Stops the drink currently being prepared.",
      "fields": {
        "device_id": {
          "name": "Coffee machine",
          "description": "The machine to stop."
        }
      }
    },
    "confirm_prompt": {
      "name": "Confirm prompt",
      "description": "Acknowledges the prompt shown on the machine display.",
      "fields": {
        "device_id": {
          "name": "Coffee machine",
          "description": "The machine showing the prompt."
        }
      }
    },
    "start_maintenance": {
      "name": "Start maintenance program",
      "description": "Starts a cleaning, descaling or water filter program.",
      "fields": {
        "device_id": {
          "name": "Coffee machine",
          "description": "The machine that should run the program."
        },
        "program": {
          "name": "Program",
          "description": "The program to start. Descaling and intensive cleaning need the matching cleaning agent in place."
        }
      }
    }
