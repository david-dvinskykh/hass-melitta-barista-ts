    "set_clock": {
      "name": "Установить часы",
      "description": "Устанавливает время на дисплее кофемашины.",
      "fields": {
        "time": {
          "name": "Время",
          "description": "Устанавливаемое время. По умолчанию — текущее местное время."
        }
      }
    },
    "write_setting": {
      "name": "Записать регистр настройки",
      "description": "Записывает произвольный числовой регистр кофемашины. Предназначено для исследования недокументированных настроек — неверное значение может привести к непредсказуемому поведению.",
      "fields": {
        "setting_id": {
          "name": "Регистр",
          "description": "Идентификатор регистра, например 11 — жёсткость воды, 13 — задержка автовыключения."
        },
        "value": {
          "name": "Значение",
          "description": "Записываемое значение."
        }
      }
    },
    "read_setting": {
      "name": "Прочитать регистр настройки",
      "description": "Читает произвольный числовой регистр кофемашины и возвращает его значение.",
      "fields": {
        "setting_id": {
          "name": "Регистр",
          "description": "Идентификатор читаемого регистра."
        }
      }
    },
    "scan_settings": {
      "name": "Сканировать регистры",
      "description": "Читает диапазон числовых регистров и возвращает те, на которые кофемашина ответила. Нужно для поиска ещё не описанных регистров; каждый регистр — это отдельный запрос, поэтому диапазон лучше держать коротким.",
      "fields": {
        "first_id": {
          "name": "Первый регистр",
          "description": "Наименьший ID регистра."
        },
        "last_id": {
          "name": "Последний регистр",
          "description": "Наибольший ID регистра, включительно."
        }
      }
    },
    "repair_connection": {
      "name": "Восстановить подключение",
      "description": "Сбрасывает Bluetooth-бонд и подключается заново. Нужно, когда машина раз за разом отказывает в спаривании, потому что адаптер держит ключ, который она больше не принимает. Для нового бонда придётся включить на машине режим сопряжения и подтвердить код на её дисплее."
    },
    "read_frame": {
      "name": "Прочитать сырой кадр",
      "description": "Запрашивает у кофемашины один из кадров, которые интеграция пока не расшифровывает, и возвращает его байты. Нужно для их разбора.",
      "fields": {
        "command": {
          "name": "Кадр",
          "description": "Какой кадр запросить."
        }
      }
    }
