        "portion_ml": {
          "name": "Объём порции",
          "description": "Объём в миллилитрах, округляется до 5 мл."
        },
        "bean_hopper": {
          "name": "Контейнер для зёрен",
          "description": "Из какого контейнера молоть зёрна. Учитывается только машинами с двумя контейнерами."
        },
        "profile": {
          "name": "Профиль",
          "description": "Приготовить из пользовательского профиля вместо встроенного рецепта. 0 — My Coffee, 1-8 — именованные профили. В профиле хранятся только семь напитков прямого выбора."
        }
      }
    },
    "cancel": {
      "name": "Отменить",
      "description": "Останавливает текущую операцию кофемашины."
